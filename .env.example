# Keep this file as documentation only. Put actual values in .env.local.
# Never prefix a secret service key with NEXT_PUBLIC_.

# Country/State/City API — used only by /api/location
LOCATION_API_KEY=

# Google Maps server key — restrict to Geocoding API only
GOOGLE_MAPS_SERVER_API_KEY=

# Google Maps browser key — restrict by HTTP referrer to your domains and to Maps JavaScript API only
GOOGLE_MAPS_BROWSER_API_KEY=

# Google Cloud Translation key — restrict to Cloud Translation API only
GOOGLE_TRANSLATE_API_KEY=
